# Postgres connection string. Required by lib/db/index.ts (pg Pool + drizzle)
# and by drizzle-kit (drizzle.config.ts) for migrate/push/studio/seed.
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio"

# Base URL of this app, read in lib/auth.ts to build Better Auth's baseURL.
BETTER_AUTH_URL="http://localhost:3000"

# Secret used by better-auth internally to sign/encrypt sessions and tokens.
# Not read explicitly via process.env in lib/auth.ts, but required by the
# better-auth library itself -- set it or auth will fail at runtime.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

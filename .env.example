# Postgres connection string (Neon). Used by Drizzle (lib/db/index.ts),
# drizzle-kit, and Payload's postgres adapter.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Base URL Better Auth uses to build callback/redirect links (lib/auth.ts).
BETTER_AUTH_URL="http://localhost:3000"

# Required by the better-auth library itself — without it, sessions use an
# insecure default secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="d7db53b0a679a15199917eff9a8ef38c071ec1566eac7244374b8981d00f9e94"

# Required by Payload (payload.config.ts). Generate with: openssl rand -base64 32
PAYLOAD_SECRET="6f7254815e516e2f967ae4e2ce927a61dd7f5625211505e7f721abae4be0ed5a"